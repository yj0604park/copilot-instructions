{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/set-title.sh",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/notify.sh",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/notify-event.sh",
        "timeoutSec": 10
      }
    ]
  }
}
