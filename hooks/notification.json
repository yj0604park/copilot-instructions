{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/session-start.sh",
        "timeoutSec": 15
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/notify.sh",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/scripts/notify-event.sh",
        "timeoutSec": 10
      }
    ]
  }
}
