[Unit]
Description=Create /dev/net/tun so Tailscale starts in tun mode (not userspace-networking)
After=basic.target
Before=pkgctl-Tailscale.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c "insmod /lib/modules/tun.ko 2>/dev/null; mkdir -p /dev/net; [ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200; chmod 0666 /dev/net/tun"

[Install]
WantedBy=syno-low-priority-packages.target
